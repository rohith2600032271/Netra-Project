<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Student Activity Management Portal">
  <meta name="author" content="University Student Affairs">
  <title>Student Activity Portal</title>
</head>
<body>
  <header>
    <h1>Student Activity Management Portal</h1>
    <nav aria-label="Main">
      <a href="#events">Events</a> |
      <a href="#register">Register</a>
    </nav>
  </header>

  <main>
    <section id="events">
      <h2>Upcoming Events</h2>
      <article>
        <h3>Tech Fest</h3>
        <p><time datetime="2026-12-05">5 Dec 2026</time> - Main Auditorium</p>
      </article>
      <article>
        <h3>Cultural Night</h3>
        <p><time datetime="2026-12-12">12 Dec 2026</time> - Open Air Theatre</p>
      </article>
    </section>

    <section id="register">
      <h2>Student Registration</h2>
      <form action="#" method="post">
        <p>
          <label for="name">Full Name</label><br>
          <input type="text" id="name" required>
        </p>
        <p>
          <label for="email">Email</label><br>
          <input type="email" id="email" required>
        </p>
        <p>
          <label for="dept">Department</label><br>
          <select id="dept" required>
            <option value="">Select</option>
            <option>CSE</option>
            <option>ECE</option>
            <option>Mechanical</option>
          </select>
        </p>

        <fieldset>
          <legend>Year of Study</legend>
          <input type="radio" id="y1" name="year" required><label for="y1">1st</label>
          <input type="radio" id="y2" name="year"><label for="y2">2nd</label>
          <input type="radio" id="y3" name="year"><label for="y3">3rd</label>
        </fieldset>

        <fieldset>
          <legend>Interests</legend>
          <input type="checkbox" id="c1"><label for="c1">Coding</label>
          <input type="checkbox" id="c2"><label for="c2">Sports</label>
          <input type="checkbox" id="c3"><label for="c3">Music</label>
        </fieldset>

        <p>
          <label for="msg">Comments</label><br>
          <textarea id="msg" rows="4" cols="40"></textarea>
        </p>

        <button type="submit">Register</button>
      </form>
    </section>
  </main>

  <aside>
    <h2>Notice</h2>
    <p>Registrations close 3 days before each event.</p>
  </aside>

  <footer>
    <p>&copy; 2026 University Student Affairs</p>
  </footer>
</body>
</html>